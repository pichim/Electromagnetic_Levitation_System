clc, clear variables
set(groot, 'defaultLineLineWidth', 1.5)
%% Controller

s = tf('s');
% PID-T1
Kp = 4.5;
Ki = 0.01; % Can't be zero
Kd = 0.109;
Tf = 1/(2*pi*35);
LP = 1/(Tf*s + 1);

C = (Kp + Ki/s + Kd*s) * LP

% Anti-Windup-Reset
% Ka = Ki / Kp;       % PI
Ka = sqrt(Ki / Kd); % PID-T1, Kd > 0
u_max = 5;
u_min = -u_max;

%% System

close all; clc;
% Konstanten von Dokumentation 2004
a = 93.24
b = -37.25
g = 9.81
k = 5.398
I0 = 2
x0 = 0.05
m = 0.04
Fg = m*g

% Berechnungen mit Formeln von Dokumentation
c2 = 2/I0
c1 = log(10)*(2*a*x0+b)
k_RS = c2/abs(c1)
T_RS = sqrt( Fg / (abs(c1)*g) )
G_RS = k_RS / (1 - s^2*T_RS^2)

%Reglerparameter
kp = 1
kd = -T_RS*kp

%C = kp + kd*s %PD Regler
T_Lead = 1;
alpha = 0.1;
C:Lead = (T_Lead*s+1) / (alpha*T_Lead*s+1); %Lead Regler

C_PD  = K * (1 + Td*s/(Tf*s+1));
C_PID = C_PD + K/(Ti*s);


LP = 1 % 1/(Tf*s+1)^1 % evtl. Tiefpass ergänzen

%Regelstrecke
L = G_RS * C * LP
T = L/(1+L)
S = 1/(1+L)

figure(1)
bode(G_RS, C)
grid on
legend('G_RS','C', 'S')

figure(2)
pzmap(G_RS)
grid on
legend('G_RS','T')


