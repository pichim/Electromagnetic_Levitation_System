if strcmp(get_param(gcb,&apos;ext&apos;),&apos;with IO-Hardware / real-time&apos;) &amp; (Ts&lt;1/eval(getpref(&apos;ZHAW_SLDRT_lib&apos;,&apos;max_sampling_frequency&apos;,&apos;20000&apos;)))
    Ts = 1/eval(getpref(&apos;ZHAW_SLDRT_lib&apos;,&apos;max_sampling_frequency&apos;,&apos;20000&apos;));
    set_param(gcb,&apos;Ts&apos;,num2str(1/eval(getpref(&apos;ZHAW_SLDRT_lib&apos;,&apos;max_sampling_frequency&apos;,&apos;20000&apos;))))
    warndlg([&apos;Sample time too smal (Ts&gt;=&apos;,num2str(1/eval(getpref(&apos;ZHAW_SLDRT_lib&apos;,&apos;max_sampling_frequency&apos;,&apos;20000&apos;))),&apos;s).&apos;])
end
set_param(gcb,&apos;fs&apos;,num2str(1/eval(get_param(gcb,&apos;Ts&apos;))));</Callback>
      </MaskParameter>
