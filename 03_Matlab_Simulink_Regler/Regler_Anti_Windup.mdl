__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_9.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="9">
  <P Name="name">MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">9</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">7</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">Ts</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">delayedAnalogSwitch</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">9</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function y = delayedAnalogSwitch(u_analog)
    % DELAYEDANALOGSWITCH Discretizes analog input and delays state changes by 0.5s.
    %   u_analog : Analog input signal (e.g. continuous voltage/current)
    %   Ts       : Sample time in seconds (e.g. 0.001)

    % Step 1: Discretize analog input (threshold: &lt; -1 -&gt; 0, otherwise -&gt; 1)
    Ts = 1/20e3;
    if u_analog &lt; -1.0
        u_bin = 0;
    else
        u_bin = 1;
    end

    % Step 2: Delay logic for the binary state
    DELAY_TIME = 0.5; % Delay duration in seconds

    % Persistent state variables
    persistent currentOutput;
    persistent targetInput;
    persistent elapsedSteps;

    % Initialize states on first execution
    if isempty(currentOutput)
        currentOutput = u_bin;
        targetInput   = u_bin;
        elapsedSteps  = 0;
    end

    % Calculate required steps to reach 0.5 seconds
    stepsRequired = ceil(DELAY_TIME / Ts);

    % Check if digitized input deviates from current output
    if u_bin ~= currentOutput
        if u_bin == targetInput
            % Input is stably holding the new state: increment timer
            elapsedSteps = elapsedSteps + 1;
            
            % Switch output if target state was held for &gt;= 0.5s
            if elapsedSteps &gt;= stepsRequired
                currentOutput = u_bin;
                elapsedSteps  = 0;
            end
        else
            % State just flipped to a new candidate: reset timer
            targetInput  = u_bin;
            elapsedSteps = 1;
        end
    else
        % Input returned to current output value: reset timer
        targetInput  = currentOutput;
        elapsedSteps = 0;
    end

    y = currentOutput;
end</P>
      </eml>
    </state>
    <data SSID="4" name="u_analog">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="y">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">9</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">9</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

