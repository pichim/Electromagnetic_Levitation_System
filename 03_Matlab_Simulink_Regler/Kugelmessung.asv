%%
% 1: 7..11 s
%2:  

%%
close all; clc;
s = tf('s')

k = 2

Gc_PDT = k * (6.556*s - 141) / (2.5e-5*s^2 + 0.01*s + 1)

Gc_PI = k * (0.0001*s+0.02) / (0.005*s)

G = 79.1 / (1 - s^2 * 0.0465^2)

%%
figure(1)
pzmap(Gc_PDT*G, Gc_PI*G)
grid on
legend('PDT', 'PI')

%%

wp = 2*pi* 3;
wz = 2*pi* 30;
F = tf([1/wz 1], [1/wp 1]);

figure(99)
bode(F), grid on

%%

load G_00.mat

Kp = db2mag(5);
Ki = 0;
Kd = 0.05;
Tf  = 1/(2*pi*30);
C = Kp + Ki/s + Kd * s / (Tf*s + 1)^2;

Tf2  = 1/(2*pi*400);
C = C */ (Tf*s + 1);

Ts_dsp = 1/500;
G.Ts = Ts_dsp;

C = c2d(C, Ts_dsp, 'tustin');

figure(100)
bode(-G, C)